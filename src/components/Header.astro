---
const links = [
  { href: '/', label: 'INICIO' },
  { href: '/quienes-somos', label: 'QUIÉNES SOMOS' },
  { href: '/productos', label: 'PRODUCTOS' },
  { href: '/contacto', label: 'CONTACTO' },
];
---

<nav class="bg-[#f8f9fa] px-3 py-3">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <a href="/" aria-label="Quimbol">
      <img src="/img/logo-quimbol-min.png" alt="Logo Quimbol" class="block w-[200px]" />
    </a>
    <div class="flex flex-wrap items-center justify-end gap-4">
      {
        links.map((link) => (
          <a href={link.href} class="text-xs font-bold text-[#343a40] no-underline md:text-2xl">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
