---
const links = [{href:'/',label:'Inicio'},{href:'/quienes-somos',label:'Quiénes somos'},{href:'/productos',label:'Productos'},{href:'/contacto',label:'Contacto'}];
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) || '/' : Astro.url.pathname;
---
<header class="site-header"><div class="shell header-inner">
<a href="/" aria-label="Quimbol, inicio"><img class="brand-logo" src="/img/logo-quimbol-min.png" alt="Quimbol" width="180" height="70" /></a>
<nav aria-label="Navegación principal">{links.map(link => <a href={link.href === '/' ? '/' : link.href + '/'} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
<a class="button header-cta" href="/contacto/">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
</div></header>
