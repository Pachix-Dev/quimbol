---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, productProcesses } from '../data/products';
import { productInquiry } from '../data/contact';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
---
<BaseLayout><section class="page-intro shell catalog-intro"><div><p class="eyebrow">QUIMBOL + QUIMSER</p><h1>Encuentra la química<br/>que necesitas.</h1><p>Soluciones para cada etapa del cuero. Consulta aplicaciones y características, y cotiza directamente con nosotros.</p></div><div class="catalog-total"><strong>{products.length}</strong><span>productos en catálogo</span></div></section>
<section class="shell catalog-section" aria-label="Catálogo de productos"><form data-reveal class="catalog-filters" role="search"><div class="search-field"><label for="product-search">Buscar producto</label><input id="product-search" type="search" placeholder="Nombre, aplicación o palabra clave…" autocomplete="off"/></div><div><label for="brand-filter">Marca</label><select id="brand-filter"><option value="">Todas las marcas</option><option>Quimbol</option><option>Quimser</option></select></div><div><label for="process-filter">Etapa de proceso</label><select id="process-filter"><option value="">Todos los procesos</option>{productProcesses.map(p=><option>{p}</option>)}</select></div><button type="reset" class="reset-button">Limpiar filtros</button></form><noscript><p>El catálogo completo está disponible. Activa JavaScript para usar la búsqueda y los filtros.</p></noscript><div class="catalog-meta"><p id="result-count" role="status" aria-live="polite">{products.length} productos</p><span>Selecciona un producto y consulta con ventas</span></div><div data-reveal class="product-grid">{products.map((p,i)=><article class="product-card" data-search={[p.name,p.nature,p.application,p.process,p.brand].join(' ')} data-brand={p.brand} data-process={p.process}><div class="card-top"><span class:list={['brand-tag',{'quimser-tag':p.brand==='Quimser'}]}>{p.brand}</span><span class="product-index">{String(i+1).padStart(2,'0')}</span></div><p class="product-process">{p.process || 'Auxiliar de proceso'}</p><h2>{p.name}</h2><p class="product-application">{p.application || p.nature}</p><dl class="product-specs"><div><dt>Estado a 25 °C</dt><dd>{p.state}</dd></div><div><dt>Concentración</dt><dd>{p.concentration || 'No especificada'}</dd></div></dl><details><summary>Características del producto</summary><p>{p.nature}</p><h3>Indicadores del catálogo</h3><dl class="risk-list"><div><dt>Riesgos a la salud</dt><dd>{p.health}</dd></div><div><dt>Inflamabilidad</dt><dd>{p.flammability}</dd></div><div><dt>Reactividad</dt><dd>{p.reactivity}</dd></div><div><dt>Riesgo específico</dt><dd>{p.specificRisk || 'No especificado'}</dd></div></dl></details><a class="product-cta" href={productInquiry(p.name)} target="_blank" rel="noopener noreferrer" aria-label={'Consultar '+p.name+' por WhatsApp'}><WhatsAppIcon/>Consultar producto <span aria-hidden="true">↗</span></a></article>)}</div><div id="empty-results" class="empty-state" hidden><h2>No encontramos coincidencias.</h2><p>Prueba otra palabra o elimina los filtros para ver todo el catálogo.</p><button class="button" id="clear-empty" type="button">Ver todos los productos</button></div></section></BaseLayout>
<script>
function initCatalog() {
const catalog = document.querySelector<HTMLFormElement>('.catalog-filters');
if (!catalog || catalog.dataset.initialized) return;
catalog.dataset.initialized = 'true';
const form = document.querySelector<HTMLFormElement>('.catalog-filters')!;
const search = document.querySelector<HTMLInputElement>('#product-search')!;
const brand = document.querySelector<HTMLSelectElement>('#brand-filter')!;
const process = document.querySelector<HTMLSelectElement>('#process-filter')!;
const cards = [...document.querySelectorAll<HTMLElement>('.product-card')];
const normalize = (s:string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g,'');
const params = new URLSearchParams(location.search);
search.value=params.get('q') || '';
if([...brand.options].some(o=>o.value===params.get('marca'))) brand.value=params.get('marca')!;
if([...process.options].some(o=>o.value===params.get('proceso'))) process.value=params.get('proceso')!;
function filter() {
 const terms=search.value.trim().split(/\s+/).map(normalize).filter(Boolean);
 let count=0;
 cards.forEach(card=>{ const match=terms.every(t=>normalize(card.dataset.search || '').includes(t)) && (!brand.value || card.dataset.brand===brand.value) && (!process.value || card.dataset.process===process.value); card.hidden=!match; if(match) count++; });
 document.querySelector('#result-count')!.textContent=count+' de '+cards.length+' productos';
 document.querySelector<HTMLElement>('#empty-results')!.hidden=count>0;
 const url=new URL(location.href);
 for(const [key,value] of [['q',search.value],['marca',brand.value],['proceso',process.value]]) { if(value) url.searchParams.set(key,value); else url.searchParams.delete(key); }
 history.replaceState(history.state,'',url);
}
form.addEventListener('submit',e=>e.preventDefault());
search.addEventListener('input',filter);
brand.addEventListener('change',filter);
process.addEventListener('change',filter);
form.addEventListener('reset',()=>setTimeout(filter,0));
document.querySelector('#clear-empty')!.addEventListener('click',()=>{form.reset();search.focus();});
filter();
}
document.addEventListener('astro:page-load', initCatalog);
initCatalog();
</script>
